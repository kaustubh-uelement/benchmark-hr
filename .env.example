# Jev: leave empty to run on the rules engine only
ANTHROPIC_API_KEY=
JEV_MODEL=claude-sonnet-5-5
# Protects POST /api/jev/cron (call hourly)
JEV_CRON_SECRET=change-me
# SQLite file (keep on a persistent volume in production)
DATABASE_PATH=./data/benchmark.db
# Optional: serve each business from its own domain
# BRAND_DOMAINS=exh1b.com=/exh1b,goldenglove.in=/goldenglove,trustcircle.in=/trustcircle,talent.benchmarkhr.in=/talent,advisory.benchmarkhr.in=/advisory
